include_guard(GLOBAL)

# STATIC_AUTO deliberately uses an explicit source marker instead of scanning
# every string literal in an application. This extractor is CMake-only so a
# normal hpclang application build does not acquire a Python dependency.

function(_hpclang_ui_hex_byte out value)
    math(EXPR _v "(${value}) & 255")
    math(EXPR _h "${_v}" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING "${_h}" 2 -1 _h)
    string(LENGTH "${_h}" _n)
    if(_n EQUAL 1)
        set(_h "0${_h}")
    endif()
    string(TOLOWER "${_h}" _h)
    set(${out} "${_h}" PARENT_SCOPE)
endfunction()

function(_hpclang_ui_utf8_hex_for_codepoint out cp)
    math(EXPR _cp "${cp}")
    if(_cp LESS 0 OR _cp GREATER 1114111 OR
       (_cp GREATER_EQUAL 55296 AND _cp LESS_EQUAL 57343))
        message(FATAL_ERROR "invalid Unicode code point ${cp}")
    endif()

    set(_hex "")
    if(_cp LESS 128)
        _hpclang_ui_hex_byte(_b "${_cp}")
        string(APPEND _hex "${_b}")
    elseif(_cp LESS 2048)
        math(EXPR _b0 "192 | (${_cp} >> 6)")
        math(EXPR _b1 "128 | (${_cp} & 63)")
        foreach(_b IN ITEMS "${_b0}" "${_b1}")
            _hpclang_ui_hex_byte(_bh "${_b}")
            string(APPEND _hex "${_bh}")
        endforeach()
    elseif(_cp LESS 65536)
        math(EXPR _b0 "224 | (${_cp} >> 12)")
        math(EXPR _b1 "128 | ((${_cp} >> 6) & 63)")
        math(EXPR _b2 "128 | (${_cp} & 63)")
        foreach(_b IN ITEMS "${_b0}" "${_b1}" "${_b2}")
            _hpclang_ui_hex_byte(_bh "${_b}")
            string(APPEND _hex "${_bh}")
        endforeach()
    else()
        math(EXPR _b0 "240 | (${_cp} >> 18)")
        math(EXPR _b1 "128 | ((${_cp} >> 12) & 63)")
        math(EXPR _b2 "128 | ((${_cp} >> 6) & 63)")
        math(EXPR _b3 "128 | (${_cp} & 63)")
        foreach(_b IN ITEMS "${_b0}" "${_b1}" "${_b2}" "${_b3}")
            _hpclang_ui_hex_byte(_bh "${_b}")
            string(APPEND _hex "${_bh}")
        endforeach()
    endif()
    set(${out} "${_hex}" PARENT_SCOPE)
endfunction()

function(_hpclang_ui_decode_utf8_hex out hex context)
    string(LENGTH "${hex}" _hlen)
    math(EXPR _rem "${_hlen} % 2")
    if(NOT _rem EQUAL 0)
        message(FATAL_ERROR "${context}: internal odd-length UTF-8 stream")
    endif()

    set(_pos 0)
    set(_cps)
    while(_pos LESS _hlen)
        string(SUBSTRING "${hex}" ${_pos} 2 _p0)
        math(EXPR _b0 "0x${_p0}")
        if(_b0 LESS 128)
            set(_cp ${_b0})
            set(_need 1)
        elseif(_b0 GREATER_EQUAL 194 AND _b0 LESS_EQUAL 223)
            set(_need 2)
        elseif(_b0 GREATER_EQUAL 224 AND _b0 LESS_EQUAL 239)
            set(_need 3)
        elseif(_b0 GREATER_EQUAL 240 AND _b0 LESS_EQUAL 244)
            set(_need 4)
        else()
            message(FATAL_ERROR "${context}: invalid UTF-8 leading byte 0x${_p0}")
        endif()

        math(EXPR _bytes_left "(${_hlen} - ${_pos}) / 2")
        if(_bytes_left LESS _need)
            message(FATAL_ERROR "${context}: truncated UTF-8 sequence")
        endif()

        if(_need GREATER 1)
            math(EXPR _cp "${_b0} & (127 >> ${_need})")
            set(_k 1)
            while(_k LESS _need)
                math(EXPR _off "${_pos} + 2 * ${_k}")
                string(SUBSTRING "${hex}" ${_off} 2 _pk)
                math(EXPR _bk "0x${_pk}")
                if(_bk LESS 128 OR _bk GREATER 191)
                    message(FATAL_ERROR "${context}: invalid UTF-8 continuation byte 0x${_pk}")
                endif()
                math(EXPR _cp "(${_cp} << 6) | (${_bk} & 63)")
                math(EXPR _k "${_k} + 1")
            endwhile()
            if((_need EQUAL 2 AND _cp LESS 128) OR
               (_need EQUAL 3 AND _cp LESS 2048) OR
               (_need EQUAL 4 AND _cp LESS 65536) OR
               _cp GREATER 1114111 OR
               (_cp GREATER_EQUAL 55296 AND _cp LESS_EQUAL 57343))
                message(FATAL_ERROR "${context}: non-canonical or invalid UTF-8 sequence")
            endif()
        endif()

        list(APPEND _cps "${_cp}")
        math(EXPR _pos "${_pos} + 2 * ${_need}")
    endwhile()
    set(${out} "${_cps}" PARENT_SCOPE)
endfunction()

function(_hpclang_ui_text_extract_file out source)
    file(READ "${source}" _data)
    string(LENGTH "${_data}" _len)
    set(_i 0)
    set(_line 1)
    set(_cps)

    while(_i LESS _len)
        string(SUBSTRING "${_data}" ${_i} 1 _ch)
        math(EXPR _next_i "${_i} + 1")
        if(_next_i LESS _len)
            string(SUBSTRING "${_data}" ${_next_i} 1 _next)
        else()
            set(_next "")
        endif()

        # Ignore marker spelling in comments.
        if(_ch STREQUAL "/" AND _next STREQUAL "/")
            math(EXPR _i "${_i} + 2")
            while(_i LESS _len)
                string(SUBSTRING "${_data}" ${_i} 1 _ch)
                if(_ch STREQUAL "\n")
                    math(EXPR _line "${_line} + 1")
                    math(EXPR _i "${_i} + 1")
                    break()
                endif()
                math(EXPR _i "${_i} + 1")
            endwhile()
            continue()
        elseif(_ch STREQUAL "/" AND _next STREQUAL "*")
            math(EXPR _i "${_i} + 2")
            set(_closed FALSE)
            while(_i LESS _len)
                string(SUBSTRING "${_data}" ${_i} 1 _ch)
                math(EXPR _next_i "${_i} + 1")
                if(_next_i LESS _len)
                    string(SUBSTRING "${_data}" ${_next_i} 1 _next)
                else()
                    set(_next "")
                endif()
                if(_ch STREQUAL "\n")
                    math(EXPR _line "${_line} + 1")
                endif()
                if(_ch STREQUAL "*" AND _next STREQUAL "/")
                    math(EXPR _i "${_i} + 2")
                    set(_closed TRUE)
                    break()
                endif()
                math(EXPR _i "${_i} + 1")
            endwhile()
            if(NOT _closed)
                message(FATAL_ERROR "${source}:${_line}: unterminated block comment")
            endif()
            continue()
        endif()

        # Ignore marker spelling inside ordinary string/character literals.
        if(_ch STREQUAL "\"" OR _ch STREQUAL "'")
            set(_quote "${_ch}")
            math(EXPR _i "${_i} + 1")
            set(_escaped FALSE)
            set(_closed FALSE)
            while(_i LESS _len)
                string(SUBSTRING "${_data}" ${_i} 1 _ch)
                if(_ch STREQUAL "\n")
                    math(EXPR _line "${_line} + 1")
                endif()
                if(_escaped)
                    set(_escaped FALSE)
                elseif(_ch STREQUAL "\\")
                    set(_escaped TRUE)
                elseif(_ch STREQUAL "${_quote}")
                    math(EXPR _i "${_i} + 1")
                    set(_closed TRUE)
                    break()
                endif()
                math(EXPR _i "${_i} + 1")
            endwhile()
            if(NOT _closed)
                message(FATAL_ERROR "${source}:${_line}: unterminated literal while scanning HPCLANG_UI_TEXT")
            endif()
            continue()
        endif()

        set(_is_marker FALSE)
        if(_ch STREQUAL "H")
            math(EXPR _remain "${_len} - ${_i}")
            if(_remain GREATER_EQUAL 15)
                string(SUBSTRING "${_data}" ${_i} 15 _token)
                if(_token STREQUAL "HPCLANG_UI_TEXT")
                    set(_prev_ok TRUE)
                    if(_i GREATER 0)
                        math(EXPR _prev_i "${_i} - 1")
                        string(SUBSTRING "${_data}" ${_prev_i} 1 _prev)
                        if(_prev MATCHES "[A-Za-z0-9_]")
                            set(_prev_ok FALSE)
                        endif()
                    endif()
                    math(EXPR _after_i "${_i} + 15")
                    set(_after_ok TRUE)
                    if(_after_i LESS _len)
                        string(SUBSTRING "${_data}" ${_after_i} 1 _after)
                        if(_after MATCHES "[A-Za-z0-9_]")
                            set(_after_ok FALSE)
                        endif()
                    endif()
                    if(_prev_ok AND _after_ok)
                        set(_is_marker TRUE)
                    endif()
                endif()
            endif()
        endif()

        if(NOT _is_marker)
            if(_ch STREQUAL "\n")
                math(EXPR _line "${_line} + 1")
            endif()
            math(EXPR _i "${_i} + 1")
            continue()
        endif()

        set(_marker_line ${_line})
        math(EXPR _j "${_i} + 15")
        while(_j LESS _len)
            string(SUBSTRING "${_data}" ${_j} 1 _ch)
            if(_ch MATCHES "[ \t\r\n]")
                if(_ch STREQUAL "\n")
                    math(EXPR _line "${_line} + 1")
                endif()
                math(EXPR _j "${_j} + 1")
            else()
                break()
            endif()
        endwhile()
        if(_j GREATER_EQUAL _len)
            message(FATAL_ERROR "${source}:${_marker_line}: HPCLANG_UI_TEXT missing '('")
        endif()
        string(SUBSTRING "${_data}" ${_j} 1 _ch)
        if(NOT _ch STREQUAL "(")
            message(FATAL_ERROR "${source}:${_marker_line}: HPCLANG_UI_TEXT must be called as HPCLANG_UI_TEXT(\"...\")")
        endif()
        math(EXPR _j "${_j} + 1")

        set(_saw_literal FALSE)
        set(_done FALSE)
        while(NOT _done)
            while(_j LESS _len)
                string(SUBSTRING "${_data}" ${_j} 1 _ch)
                if(_ch MATCHES "[ \t\r\n]")
                    if(_ch STREQUAL "\n")
                        math(EXPR _line "${_line} + 1")
                    endif()
                    math(EXPR _j "${_j} + 1")
                else()
                    break()
                endif()
            endwhile()
            if(_j GREATER_EQUAL _len)
                message(FATAL_ERROR "${source}:${_marker_line}: unterminated HPCLANG_UI_TEXT")
            endif()
            string(SUBSTRING "${_data}" ${_j} 1 _ch)
            if(_ch STREQUAL ")")
                if(NOT _saw_literal)
                    message(FATAL_ERROR "${source}:${_marker_line}: HPCLANG_UI_TEXT requires a narrow UTF-8 string literal")
                endif()
                math(EXPR _j "${_j} + 1")
                set(_done TRUE)
                break()
            endif()
            if(NOT _ch STREQUAL "\"")
                message(FATAL_ERROR "${source}:${_marker_line}: HPCLANG_UI_TEXT accepts only adjacent narrow UTF-8 string literals")
            endif()

            set(_saw_literal TRUE)
            math(EXPR _j "${_j} + 1")
            set(_hex "")
            set(_literal_closed FALSE)
            while(_j LESS _len)
                string(SUBSTRING "${_data}" ${_j} 1 _ch)
                if(_ch STREQUAL "\"")
                    math(EXPR _j "${_j} + 1")
                    set(_literal_closed TRUE)
                    break()
                endif()
                if(_ch STREQUAL "\n")
                    message(FATAL_ERROR "${source}:${_marker_line}: raw newline in HPCLANG_UI_TEXT literal")
                endif()
                if(NOT _ch STREQUAL "\\")
                    string(HEX "${_ch}" _hx)
                    string(APPEND _hex "${_hx}")
                    math(EXPR _j "${_j} + 1")
                    continue()
                endif()

                math(EXPR _j "${_j} + 1")
                if(_j GREATER_EQUAL _len)
                    message(FATAL_ERROR "${source}:${_marker_line}: trailing backslash in HPCLANG_UI_TEXT literal")
                endif()
                string(SUBSTRING "${_data}" ${_j} 1 _esc)
                if(_esc STREQUAL "\n")
                    math(EXPR _line "${_line} + 1")
                    math(EXPR _j "${_j} + 1")
                    continue()
                endif()

                if(_esc STREQUAL "n")
                    set(_byte 10)
                elseif(_esc STREQUAL "r")
                    set(_byte 13)
                elseif(_esc STREQUAL "t")
                    set(_byte 9)
                elseif(_esc STREQUAL "a")
                    set(_byte 7)
                elseif(_esc STREQUAL "b")
                    set(_byte 8)
                elseif(_esc STREQUAL "f")
                    set(_byte 12)
                elseif(_esc STREQUAL "v")
                    set(_byte 11)
                elseif(_esc STREQUAL "\\")
                    set(_byte 92)
                elseif(_esc STREQUAL "\"")
                    set(_byte 34)
                elseif(_esc STREQUAL "'")
                    set(_byte 39)
                elseif(_esc STREQUAL "?")
                    set(_byte 63)
                else()
                    set(_byte "")
                endif()
                if(NOT _byte STREQUAL "")
                    _hpclang_ui_hex_byte(_bh "${_byte}")
                    string(APPEND _hex "${_bh}")
                    math(EXPR _j "${_j} + 1")
                    continue()
                endif()

                if(_esc MATCHES "[0-7]")
                    set(_value 0)
                    set(_count 0)
                    while(_j LESS _len AND _count LESS 3)
                        string(SUBSTRING "${_data}" ${_j} 1 _d)
                        if(NOT _d MATCHES "[0-7]")
                            break()
                        endif()
                        math(EXPR _value "${_value} * 8 + ${_d}")
                        math(EXPR _j "${_j} + 1")
                        math(EXPR _count "${_count} + 1")
                    endwhile()
                    _hpclang_ui_hex_byte(_bh "${_value}")
                    string(APPEND _hex "${_bh}")
                    continue()
                elseif(_esc STREQUAL "x")
                    math(EXPR _j "${_j} + 1")
                    set(_digits "")
                    while(_j LESS _len)
                        string(SUBSTRING "${_data}" ${_j} 1 _d)
                        if(NOT _d MATCHES "[0-9A-Fa-f]")
                            break()
                        endif()
                        string(APPEND _digits "${_d}")
                        math(EXPR _j "${_j} + 1")
                    endwhile()
                    if(_digits STREQUAL "")
                        message(FATAL_ERROR "${source}:${_marker_line}: \\x escape requires hex digits")
                    endif()
                    math(EXPR _value "0x${_digits}")
                    if(_value GREATER 255)
                        message(FATAL_ERROR "${source}:${_marker_line}: \\x${_digits} does not fit one UTF-8 byte")
                    endif()
                    _hpclang_ui_hex_byte(_bh "${_value}")
                    string(APPEND _hex "${_bh}")
                    continue()
                elseif(_esc STREQUAL "u" OR _esc STREQUAL "U")
                    if(_esc STREQUAL "u")
                        set(_digits_needed 4)
                    else()
                        set(_digits_needed 8)
                    endif()
                    math(EXPR _j "${_j} + 1")
                    math(EXPR _end "${_j} + ${_digits_needed}")
                    if(_end GREATER _len)
                        message(FATAL_ERROR "${source}:${_marker_line}: truncated Unicode escape")
                    endif()
                    string(SUBSTRING "${_data}" ${_j} ${_digits_needed} _digits)
                    if(NOT _digits MATCHES "^[0-9A-Fa-f]+$")
                        message(FATAL_ERROR "${source}:${_marker_line}: invalid Unicode escape \\${_esc}${_digits}")
                    endif()
                    math(EXPR _value "0x${_digits}")
                    _hpclang_ui_utf8_hex_for_codepoint(_uh "${_value}")
                    string(APPEND _hex "${_uh}")
                    set(_j ${_end})
                    continue()
                endif()
                message(FATAL_ERROR "${source}:${_marker_line}: unsupported escape \\${_esc} in HPCLANG_UI_TEXT")
            endwhile()

            if(NOT _literal_closed)
                message(FATAL_ERROR "${source}:${_marker_line}: unterminated HPCLANG_UI_TEXT literal")
            endif()
            _hpclang_ui_decode_utf8_hex(_literal_cps "${_hex}" "${source}:${_marker_line}")
            list(APPEND _cps ${_literal_cps})
        endwhile()
        set(_i ${_j})
    endwhile()

    set(${out} "${_cps}" PARENT_SCOPE)
endfunction()

function(hpclang_collect_ui_text_codepoints out)
    set(_all)
    foreach(_source IN LISTS ARGN)
        if(NOT EXISTS "${_source}")
            message(FATAL_ERROR "STATIC_AUTO UI source does not exist: ${_source}")
        endif()
        _hpclang_ui_text_extract_file(_one "${_source}")
        list(APPEND _all ${_one})
    endforeach()

    # NUL terminates hpclang text and newline is layout control, not a glyph.
    list(REMOVE_ITEM _all 0 10)
    list(REMOVE_DUPLICATES _all)
    if(_all)
        list(SORT _all COMPARE NATURAL ORDER ASCENDING)
    endif()
    set(${out} "${_all}" PARENT_SCOPE)
endfunction()
