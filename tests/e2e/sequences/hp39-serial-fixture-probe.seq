# HP39gs/HP40gs stock serial-disk fixture probe.
# F6 dismisses the two stock boot prompts used by the direct-runtime gate.
2000 tap f6
4000 tap f6

# Open Aplet Library, where F5 is RECV.
7000 tap aplet
8000 capture aplet-library
9000 tap f5
10000 capture receive-menu

# gs/40gs receive menu:
#   HP39/40 (USB)
#   HP39/40 (SER)
#   USB DISK DRIVE
#   SER. DISK DRIVE
10500 tap down
10900 tap down
11300 tap down
11800 capture serial-disk-selected
12300 tap enter

17000 capture serial-disk-active
35000 finish-install
